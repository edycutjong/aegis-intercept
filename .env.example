# ============================================================================
# Aegis Intercept — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase Service Role (Backend/Ingestion Only) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Liquify Indexer API ---
LIQUIFY_API_KEY=your-liquify-api-key-here
LIQUIFY_ETH_ENDPOINT=https://eth.liquify.io/v1
LIQUIFY_ARB_ENDPOINT=https://arb.liquify.io/v1
LIQUIFY_BASE_ENDPOINT=https://base.liquify.io/v1
LIQUIFY_BNB_ENDPOINT=https://bnb.liquify.io/v1

# --- Discord Webhook (Notifications) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# --- Standard RPCs (Benchmark Comparison) ---
BENCHMARK_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/your-key
BENCHMARK_ARB_RPC=https://arb-mainnet.g.alchemy.com/v2/your-key
BENCHMARK_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/your-key
BENCHMARK_BNB_RPC=https://bsc-dataseed1.binance.org
